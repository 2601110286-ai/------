<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mood Trip Planner</title>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --ink: #172026;
            --muted: #62707d;
            --line: rgba(23, 32, 38, 0.1);
            --paper: rgba(255, 255, 255, 0.82);
            --green: #1f8a70;
            --blue: #3478f6;
            --coral: #ff6f61;
            --yellow: #f8c14a;
            --soft: #f5f7fb;
        }

        body {
            min-height: 100vh;
            color: var(--ink);
            background:
                radial-gradient(circle at 8% 8%, rgba(248, 193, 74, 0.3), transparent 28rem),
                radial-gradient(circle at 92% 10%, rgba(52, 120, 246, 0.16), transparent 25rem),
                linear-gradient(135deg, #f8fbff 0%, #eef8f3 48%, #fff6ef 100%);
            font-family: "Pretendard", "Noto Sans KR", "Malgun Gothic", Arial, sans-serif;
            overflow-x: hidden;
        }

        header {
            position: sticky;
            top: 0;
            z-index: 20;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 1rem 7vw;
            background: rgba(255, 255, 255, 0.82);
            border-bottom: 1px solid var(--line);
            backdrop-filter: blur(18px);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-weight: 900;
            font-size: 1.08rem;
        }

        .brand-mark {
            display: grid;
            place-items: center;
            width: 2.6rem;
            height: 2.6rem;
            border-radius: 0.8rem;
            color: white;
            background: linear-gradient(135deg, var(--green), var(--blue));
            box-shadow: 0 14px 28px rgba(31, 138, 112, 0.22);
            animation: markFloat 3s ease-in-out infinite;
        }

        nav {
            display: flex;
            align-items: center;
            gap: 0.35rem;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        nav a {
            color: #4f5d68;
            text-decoration: none;
            font-weight: 800;
            font-size: 0.92rem;
            padding: 0.55rem 0.85rem;
            border-radius: 999px;
            transition: 0.22s ease;
        }

        nav a:hover {
            color: white;
            background: var(--green);
            transform: translateY(-2px);
        }

        button, input, select {
            font: inherit;
        }

        button {
            border: 0;
            cursor: pointer;
        }

        main {
            padding: 0 7vw 4rem;
        }

        .hero {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(22rem, 0.95fr);
            align-items: center;
            gap: 3.5rem;
            min-height: calc(100vh - 4.8rem);
            padding: 3rem 0;
        }

        .hero-copy {
            animation: fadeUp 0.8s ease both;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            padding: 0.45rem 0.8rem;
            border: 1px solid rgba(31, 138, 112, 0.24);
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.76);
            color: var(--green);
            font-weight: 900;
            font-size: 0.88rem;
        }

        h1 {
            max-width: 10ch;
            margin-top: 1.1rem;
            font-size: clamp(3.4rem, 8vw, 6.8rem);
            line-height: 0.94;
            letter-spacing: 0;
        }

        .hero-copy p {
            max-width: 42rem;
            margin: 1.35rem 0 1.7rem;
            color: var(--muted);
            font-size: 1.08rem;
            line-height: 1.75;
        }

        .hero-actions {
            display: flex;
            gap: 0.8rem;
            flex-wrap: wrap;
        }

        .primary-btn, .ghost-btn {
            min-height: 3rem;
            padding: 0.78rem 1.08rem;
            border-radius: 0.7rem;
            font-weight: 900;
            transition: 0.22s ease;
        }

        .primary-btn {
            color: white;
            background: var(--coral);
            box-shadow: 0 18px 32px rgba(255, 111, 97, 0.25);
        }

        .ghost-btn {
            color: var(--green);
            background: white;
            border: 1px solid rgba(31, 138, 112, 0.22);
        }

        .primary-btn:hover, .ghost-btn:hover {
            transform: translateY(-3px);
        }

        .map-card {
            position: relative;
            min-height: 34rem;
            border-radius: 2rem;
            overflow: hidden;
            background:
                linear-gradient(135deg, rgba(23, 32, 38, 0.08), rgba(23, 32, 38, 0.42)),
                url("https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1000&q=85") center/cover;
            box-shadow: 0 30px 70px rgba(23, 32, 38, 0.16);
            animation: mapFloat 5s ease-in-out infinite;
        }

        .map-card::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(23, 32, 38, 0.28));
        }

        .route {
            position: absolute;
            left: 12%;
            top: 33%;
            width: 72%;
            height: 40%;
            border: 4px dashed rgba(255, 255, 255, 0.5);
            border-left-color: transparent;
            border-bottom-color: transparent;
            border-radius: 50%;
            transform: rotate(-8deg);
        }

        .pin {
            position: absolute;
            display: grid;
            place-items: center;
            width: 4.4rem;
            height: 4.4rem;
            border-radius: 1.4rem 1.4rem 1.4rem 0.35rem;
            color: white;
            font-size: 1.8rem;
            box-shadow: 0 18px 32px rgba(23, 32, 38, 0.18);
            animation: pinBounce 2.8s ease-in-out infinite;
        }

        .pin:nth-child(2) { left: 18%; top: 20%; background: var(--coral); }
        .pin:nth-child(3) { right: 16%; top: 28%; background: var(--blue); animation-delay: -0.8s; }
        .pin:nth-child(4) { left: 42%; bottom: 17%; background: var(--green); animation-delay: -1.4s; }

        .weather-chip {
            position: absolute;
            right: 1.2rem;
            bottom: 1.2rem;
            width: calc(100% - 2.4rem);
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 1rem;
            align-items: center;
            padding: 1rem;
            border-radius: 1rem;
            color: white;
            background: rgba(23, 32, 38, 0.62);
            backdrop-filter: blur(10px);
        }

        .weather-chip strong {
            display: block;
            font-size: 1.25rem;
        }

        .weather-chip span {
            color: rgba(255, 255, 255, 0.82);
            font-size: 0.92rem;
        }

        .section-head {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: 1.2rem;
            margin: 3rem 0 1.2rem;
        }

        .section-head h2 {
            font-size: clamp(2rem, 4vw, 3.2rem);
        }

        .section-head p {
            max-width: 39rem;
            color: var(--muted);
            line-height: 1.65;
        }

        .controls {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 1rem;
            margin-bottom: 1.1rem;
        }

        .search-box {
            min-height: 3rem;
            padding: 0 1rem;
            border: 1px solid var(--line);
            border-radius: 0.7rem;
            background: rgba(255, 255, 255, 0.85);
            outline: 0;
        }

        .filter-wrap {
            display: flex;
            gap: 0.55rem;
            flex-wrap: wrap;
        }

        .filter-btn {
            padding: 0.72rem 0.95rem;
            border-radius: 999px;
            color: #46535e;
            background: rgba(255, 255, 255, 0.82);
            border: 1px solid var(--line);
            font-weight: 900;
            transition: 0.2s ease;
        }

        .filter-btn.active, .filter-btn:hover {
            color: white;
            background: var(--green);
        }

        .destination-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1rem;
        }

        .destination-card {
            min-height: 27rem;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            border-radius: 1rem;
            background: var(--paper);
            border: 1px solid var(--line);
            box-shadow: 0 18px 36px rgba(23, 32, 38, 0.08);
            transition: transform 0.24s, box-shadow 0.24s;
        }

        .destination-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 26px 52px rgba(23, 32, 38, 0.14);
        }

        .card-visual {
            position: relative;
            min-height: 12rem;
            overflow: hidden;
            background: #dfe8ec;
        }

        .card-visual img {
            width: 100%;
            height: 12rem;
            display: block;
            object-fit: cover;
            transition: transform 0.35s ease;
        }

        .destination-card:hover .card-visual img {
            transform: scale(1.07);
        }

        .card-visual::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, transparent 35%, rgba(23, 32, 38, 0.42));
        }

        .visual-icon {
            position: absolute;
            left: 1.2rem;
            bottom: 1rem;
            z-index: 1;
            font-size: 3rem;
            filter: drop-shadow(0 8px 12px rgba(23, 32, 38, 0.18));
        }

        .card-body {
            display: flex;
            flex-direction: column;
            flex: 1;
            gap: 0.75rem;
            padding: 1rem;
        }

        .meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 0.7rem;
        }

        .tag {
            display: inline-flex;
            width: fit-content;
            padding: 0.32rem 0.62rem;
            border-radius: 999px;
            color: var(--green);
            background: #e4f6ef;
            font-size: 0.78rem;
            font-weight: 900;
        }

        .cost {
            color: var(--coral);
            font-weight: 950;
        }

        .card-body h3 {
            font-size: 1.25rem;
        }

        .card-body p {
            color: var(--muted);
            line-height: 1.55;
            font-size: 0.95rem;
        }

        .card-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.55rem;
            margin-top: auto;
        }

        .dark-btn, .line-btn {
            min-height: 2.7rem;
            border-radius: 0.6rem;
            font-weight: 900;
        }

        .dark-btn {
            color: white;
            background: var(--ink);
        }

        .line-btn {
            color: var(--ink);
            background: white;
            border: 1px solid var(--line);
        }

        .planner-panel {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-top: 2rem;
        }

        .panel {
            padding: 1.25rem;
            border-radius: 1rem;
            background: rgba(255, 255, 255, 0.86);
            border: 1px solid var(--line);
            box-shadow: 0 18px 36px rgba(23, 32, 38, 0.08);
        }

        .panel h2 {
            margin-bottom: 0.8rem;
            font-size: 1.35rem;
        }

        .course-list {
            display: grid;
            gap: 0.55rem;
            min-height: 9rem;
        }

        .course-item {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 0.6rem;
            align-items: center;
            padding: 0.75rem;
            border-radius: 0.65rem;
            background: #f5faf7;
            animation: popIn 0.28s ease both;
        }

        .remove-btn {
            width: 2rem;
            height: 2rem;
            border-radius: 50%;
            color: white;
            background: var(--coral);
            font-weight: 900;
        }

        .budget-line {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 1rem;
            padding-top: 1rem;
            border-top: 1px solid var(--line);
            font-size: 1.15rem;
            font-weight: 950;
        }

        .progress-wrap {
            height: 0.8rem;
            overflow: hidden;
            border-radius: 999px;
            background: #e9eef0;
            margin-top: 1rem;
        }

        .progress-bar {
            width: 0;
            height: 100%;
            border-radius: inherit;
            background: linear-gradient(90deg, var(--green), var(--blue), var(--coral));
        }

        .recommend-card {
            min-height: 9rem;
            padding: 1rem;
            border-radius: 0.8rem;
            background: #fff6e5;
            border: 1px dashed rgba(255, 111, 97, 0.45);
            line-height: 1.6;
        }

        .recommend-card strong {
            font-size: 1.15rem;
        }

        .photo-grid {
            display: grid;
            grid-template-columns: 1.1fr 0.9fr 0.9fr;
            gap: 1rem;
            margin-top: 2rem;
        }

        .photo-tile {
            position: relative;
            min-height: 18rem;
            border-radius: 1rem;
            overflow: hidden;
            background: #dfe8ec;
            box-shadow: 0 18px 36px rgba(23, 32, 38, 0.1);
        }

        .photo-tile:first-child {
            grid-row: span 2;
            min-height: 37rem;
        }

        .photo-tile img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            transition: transform 0.45s ease;
        }

        .photo-tile:hover img {
            transform: scale(1.08);
        }

        .photo-caption {
            position: absolute;
            left: 1rem;
            right: 1rem;
            bottom: 1rem;
            padding: 0.85rem;
            border-radius: 0.8rem;
            color: white;
            background: rgba(23, 32, 38, 0.58);
            backdrop-filter: blur(10px);
        }

        .photo-caption strong {
            display: block;
            margin-bottom: 0.25rem;
        }

        .toast {
            position: fixed;
            right: 1.25rem;
            bottom: 1.25rem;
            z-index: 60;
            max-width: 21rem;
            padding: 0.9rem 1rem;
            border-radius: 0.75rem;
            color: white;
            background: var(--ink);
            box-shadow: 0 18px 36px rgba(23, 32, 38, 0.22);
            transform: translateY(150%);
            transition: transform 0.28s ease;
            font-weight: 900;
        }

        .toast.show {
            transform: translateY(0);
        }

        .modal {
            position: fixed;
            inset: 0;
            z-index: 50;
            display: none;
            place-items: center;
            padding: 1rem;
            background: rgba(23, 32, 38, 0.54);
        }

        .modal-content {
            width: min(34rem, 100%);
            border-radius: 1rem;
            background: white;
            box-shadow: 0 30px 80px rgba(23, 32, 38, 0.25);
            overflow: hidden;
        }

        .modal-visual {
            min-height: 12rem;
        }

        .modal-body {
            padding: 1.2rem;
        }

        .modal-body p {
            color: var(--muted);
            line-height: 1.7;
            margin: 0.7rem 0 1rem;
        }

        footer {
            padding: 2rem 7vw;
            text-align: center;
            color: var(--muted);
        }

        @keyframes markFloat {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-4px) rotate(-5deg); }
        }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(24px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes mapFloat {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-14px); }
        }

        @keyframes pinBounce {
            0%, 100% { transform: translateY(0) rotate(-5deg); }
            50% { transform: translateY(-17px) rotate(4deg); }
        }

        @keyframes popIn {
            from { opacity: 0; transform: scale(0.92); }
            to { opacity: 1; transform: scale(1); }
        }

        @media (max-width: 980px) {
            header {
                align-items: flex-start;
                flex-direction: column;
            }

            nav {
                justify-content: flex-start;
            }

            .hero, .planner-panel {
                grid-template-columns: 1fr;
            }

            .destination-grid, .photo-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .photo-tile:first-child {
                grid-row: auto;
                min-height: 18rem;
            }
        }

        @media (max-width: 640px) {
            header, main, footer {
                padding-left: 1rem;
                padding-right: 1rem;
            }

            .hero {
                min-height: auto;
                gap: 1.6rem;
            }

            .map-card {
                min-height: 25rem;
            }

            .controls, .destination-grid, .photo-grid {
                grid-template-columns: 1fr;
            }

            .section-head {
                align-items: flex-start;
                flex-direction: column;
            }
        }
    </style>
</head>
<body>
    <header>
        <div class="brand">
            <div class="brand-mark">✦</div>
            <span>Mood Trip Planner</span>
        </div>
        <nav>
            <a href="#destinations">여행지</a>
            <a href="#planner">코스</a>
            <a href="#gallery">갤러리</a>
        </nav>
    </header>

    <main>
        <section class="hero">
            <div class="hero-copy">
                <span class="eyebrow">기분에 맞춰 완성하는 여행 코스</span>
                <h1>Mood Trip Planner</h1>
                <p>
                    바다, 도시, 숲, 카페처럼 오늘 끌리는 분위기를 골라 나만의 여행 코스를 만들어보세요.
                    마음에 드는 장소를 담으면 예상 비용까지 한 번에 정리됩니다.
                </p>
                <div class="hero-actions">
                    <button class="primary-btn" id="startBtn">여행지 둘러보기</button>
                    <button class="ghost-btn" id="randomHeroBtn">랜덤 추천 받기</button>
                </div>
            </div>

            <div class="map-card" aria-label="여행 지도 일러스트">
                <div class="route"></div>
                <div class="pin">🌊</div>
                <div class="pin">🏙</div>
                <div class="pin">⛰</div>
                <div class="weather-chip">
                    <div>
                        <strong>오늘의 추천 루트</strong>
                        <span>필터와 검색으로 나만의 코스를 만들어보세요.</span>
                    </div>
                    <button class="primary-btn" id="mapAddBtn">담기</button>
                </div>
            </div>
        </section>

        <section id="destinations">
            <div class="section-head">
                <div>
                    <h2>Choose Your Mood</h2>
                </div>
                <p>지금 떠나고 싶은 분위기를 고르고, 마음에 드는 여행지를 코스에 담아보세요.</p>
            </div>

            <div class="controls">
                <input id="searchInput" class="search-box" type="text" placeholder="여행지 이름이나 키워드를 검색하세요">
                <div class="filter-wrap">
                    <button class="filter-btn active" data-filter="all">전체</button>
                    <button class="filter-btn" data-filter="ocean">바다</button>
                    <button class="filter-btn" data-filter="city">도시</button>
                    <button class="filter-btn" data-filter="nature">자연</button>
                    <button class="filter-btn" data-filter="healing">힐링</button>
                </div>
            </div>

            <div class="destination-grid" id="destinationGrid"></div>
        </section>

        <section class="planner-panel" id="planner">
            <div class="panel">
                <h2>My Travel Course</h2>
                <div class="course-list" id="courseList"></div>
                <div class="progress-wrap">
                    <div class="progress-bar" id="progressBar"></div>
                </div>
                <div class="budget-line">
                    <span>예상 여행 비용</span>
                    <strong id="totalBudget">0원</strong>
                </div>
            </div>

            <div class="panel">
                <h2>Random Trip Pick</h2>
                <div class="recommend-card" id="recommendCard">
                    랜덤 추천 버튼을 누르면 오늘의 여행지가 나타납니다.
                </div>
                <br>
                <button class="primary-btn" id="randomBtn">랜덤 추천</button>
            </div>
        </section>

        <section id="gallery">
            <div class="section-head">
                <div>
                    <h2>Trip Gallery</h2>
                </div>
                <p>가고 싶은 장면을 한눈에 모아두었습니다.</p>
            </div>
            <div class="photo-grid">
                <article class="photo-tile">
                    <img src="https://images.unsplash.com/photo-1542897644-e04428948020?auto=format&fit=crop&w=900&q=80" alt="제주 바다 해안도로">
                    <div class="photo-caption"><strong>Jeju Ocean Road</strong><span>푸른 바다를 따라 달리는 해안 코스</span></div>
                </article>
                <article class="photo-tile">
                    <img src="https://images.unsplash.com/photo-1538485399081-7191377e8241?auto=format&fit=crop&w=700&q=80" alt="서울 야경">
                    <div class="photo-caption"><strong>Seoul Night Walk</strong><span>빛나는 도시 야경 산책</span></div>
                </article>
                <article class="photo-tile">
                    <img src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=700&q=80" alt="자연 숲길">
                    <div class="photo-caption"><strong>Forest Day</strong><span>천천히 걷는 숲 여행</span></div>
                </article>
                <article class="photo-tile">
                    <img src="https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=700&q=80" alt="카페 여행">
                    <div class="photo-caption"><strong>Cafe Trip</strong><span>바다 근처에서 쉬어가는 카페 코스</span></div>
                </article>
                <article class="photo-tile">
                    <img src="https://images.unsplash.com/photo-1517154421773-0529f29ea451?auto=format&fit=crop&w=700&q=80" alt="전통 여행지">
                    <div class="photo-caption"><strong>Slow Picnic</strong><span>로컬 분위기를 느끼는 하루</span></div>
                </article>
            </div>
        </section>
    </main>

    <footer>
        Mood Trip Planner
    </footer>

    <div class="modal" id="detailModal">
        <div class="modal-content">
            <div class="modal-visual" id="modalVisual"></div>
            <div class="modal-body">
                <h2 id="modalTitle"></h2>
                <p id="modalDesc"></p>
                <button class="primary-btn" id="modalAddBtn">코스에 담기</button>
                <button class="ghost-btn" id="modalCloseBtn">닫기</button>
            </div>
        </div>
    </div>

    <div class="toast" id="toast"></div>

    <script>
        if (!window.jQuery) {
            document.write('<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"><\\/script>');
        }
    </script>
    <script>
        const destinations = [
            { id: 1, name: "Jeju Ocean Road", type: "ocean", tag: "바다", icon: "🌊", cost: 180000, color: "linear-gradient(135deg,#6dd5ed,#2193b0)", image: "https://images.unsplash.com/photo-1542897644-e04428948020?auto=format&fit=crop&w=700&q=80", desc: "푸른 바다와 해안도로를 따라 여유롭게 달리는 제주 감성 코스입니다.", keywords: "제주 바다 해안 힐링" },
            { id: 2, name: "Seoul Night Walk", type: "city", tag: "도시", icon: "🏙", cost: 90000, color: "linear-gradient(135deg,#667eea,#764ba2)", image: "https://images.unsplash.com/photo-1538485399081-7191377e8241?auto=format&fit=crop&w=700&q=80", desc: "야경, 전시, 맛집을 한 번에 즐길 수 있는 도심 산책 코스입니다.", keywords: "서울 도시 야경 전시" },
            { id: 3, name: "Gangneung Cafe Trip", type: "healing", tag: "힐링", icon: "☕", cost: 130000, color: "linear-gradient(135deg,#f6d365,#fda085)", image: "https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=700&q=80", desc: "바다 근처 카페와 산책길을 중심으로 구성한 감성 휴식 여행입니다.", keywords: "강릉 카페 바다 휴식" },
            { id: 4, name: "Seorak Forest Day", type: "nature", tag: "자연", icon: "⛰", cost: 150000, color: "linear-gradient(135deg,#11998e,#38ef7d)", image: "https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=700&q=80", desc: "숲길과 전망대를 걸으며 자연을 느끼는 산책형 여행 코스입니다.", keywords: "설악산 숲 산 자연" },
            { id: 5, name: "Busan Blue Weekend", type: "ocean", tag: "바다", icon: "🚆", cost: 170000, color: "linear-gradient(135deg,#4facfe,#00f2fe)", image: "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=700&q=80", desc: "기차를 타고 떠나는 부산 바다, 시장, 야경 주말 코스입니다.", keywords: "부산 바다 기차 야경" },
            { id: 6, name: "Jeonju Slow Picnic", type: "healing", tag: "힐링", icon: "🍱", cost: 110000, color: "linear-gradient(135deg,#ffecd2,#fcb69f)", image: "https://images.unsplash.com/photo-1517154421773-0529f29ea451?auto=format&fit=crop&w=700&q=80", desc: "한옥마을과 로컬 음식을 천천히 즐기는 하루 피크닉 코스입니다.", keywords: "전주 한옥 음식 피크닉" }
        ];

        let currentFilter = "all";
        let course = [];
        let selectedId = null;

        function won(value) {
            return value.toLocaleString("ko-KR") + "원";
        }

        function showToast(message) {
            $("#toast").text(message).addClass("show");
            clearTimeout(showToast.timer);
            showToast.timer = setTimeout(function () {
                $("#toast").removeClass("show");
            }, 1700);
        }

        function renderCards() {
            const keyword = $("#searchInput").val().trim().toLowerCase();
            const filtered = destinations.filter(function (item) {
                const matchFilter = currentFilter === "all" || item.type === currentFilter;
                const matchKeyword = !keyword || (item.name + item.desc + item.keywords).toLowerCase().includes(keyword);
                return matchFilter && matchKeyword;
            });

            $("#destinationGrid").hide().empty();

            if (filtered.length === 0) {
                $("#destinationGrid").append('<p>검색 결과가 없습니다.</p>');
            }

            $.each(filtered, function (index, item) {
                const card = $(`
                    <article class="destination-card" style="display:none">
                        <div class="card-visual">
                            <img src="${item.image}" alt="${item.name}">
                            <div class="visual-icon">${item.icon}</div>
                        </div>
                        <div class="card-body">
                            <div class="meta">
                                <span class="tag">${item.tag}</span>
                                <span class="cost">${won(item.cost)}</span>
                            </div>
                            <h3>${item.name}</h3>
                            <p>${item.desc}</p>
                            <div class="card-actions">
                                <button class="dark-btn add-course" data-id="${item.id}">코스 담기</button>
                                <button class="line-btn detail-view" data-id="${item.id}">자세히</button>
                            </div>
                        </div>
                    </article>
                `);
                $("#destinationGrid").append(card);
                card.delay(index * 90).fadeIn(260);
            });

            $("#destinationGrid").fadeIn(180);
        }

        function addCourse(id) {
            const item = destinations.find(function (place) { return place.id === Number(id); });
            if (course.find(function (place) { return place.id === item.id; })) {
                showToast("이미 코스에 담긴 여행지입니다.");
                return;
            }
            course.push(item);
            renderCourse();
            showToast(item.name + " 코스에 추가 완료");
        }

        function renderCourse() {
            $("#courseList").empty();

            if (course.length === 0) {
                $("#courseList").append("<p>아직 담은 여행지가 없습니다.</p>");
            }

            let total = 0;
            $.each(course, function (_, item) {
                total += item.cost;
                $("#courseList").append(`
                    <div class="course-item">
                        <div>
                            <strong>${item.icon} ${item.name}</strong><br>
                            <span>${won(item.cost)}</span>
                        </div>
                        <button class="remove-btn" data-id="${item.id}">×</button>
                    </div>
                `);
            });

            $("#totalBudget").text(won(total));
            $("#progressBar").stop().animate({ width: Math.min(course.length * 25, 100) + "%" }, 420);
        }

        function randomPick() {
            const item = destinations[Math.floor(Math.random() * destinations.length)];
            $("#recommendCard").fadeOut(120, function () {
                $(this)
                    .html(`<strong>${item.icon} ${item.name}</strong><br>${item.desc}<br><span class="cost">${won(item.cost)}</span>`)
                    .fadeIn(240)
                    .animate({ marginLeft: "8px" }, 90)
                    .animate({ marginLeft: "0px" }, 90);
            });
            showToast("랜덤 여행지가 선택되었습니다.");
        }

        function openModal(id) {
            const item = destinations.find(function (place) { return place.id === Number(id); });
            selectedId = item.id;
            $("#modalVisual").css({
                background: `linear-gradient(180deg, transparent 35%, rgba(23,32,38,0.5)), url('${item.image}') center/cover`
            }).html(`<div class="visual-icon">${item.icon}</div>`);
            $("#modalTitle").text(item.name);
            $("#modalDesc").text(item.desc + " 예상 비용은 " + won(item.cost) + "이며, " + item.tag + " 분위기를 좋아하는 사용자에게 어울립니다.");
            $("#detailModal").css("display", "grid").hide().fadeIn(180);
            $(".modal-content").css({ transform: "translateY(18px)", opacity: 0 }).animate({ transform: "translateY(0px)", opacity: 1 }, 220);
        }

        $(function () {
            renderCards();
            renderCourse();

            $(".filter-btn").on("click", function () {
                $(".filter-btn").removeClass("active");
                $(this).addClass("active");
                currentFilter = $(this).data("filter");
                renderCards();
            });

            $("#searchInput").on("keyup", renderCards);

            $("#destinationGrid").on("click", ".add-course", function () {
                addCourse($(this).data("id"));
            });

            $("#destinationGrid").on("click", ".detail-view", function () {
                openModal($(this).data("id"));
            });

            $("#courseList").on("click", ".remove-btn", function () {
                const id = Number($(this).data("id"));
                course = course.filter(function (item) { return item.id !== id; });
                renderCourse();
                showToast("코스에서 삭제되었습니다.");
            });

            $("#randomBtn, #randomHeroBtn").on("click", function () {
                $("#planner")[0].scrollIntoView({ behavior: "smooth" });
                setTimeout(randomPick, 360);
            });

            $("#startBtn").on("click", function () {
                $("#destinations")[0].scrollIntoView({ behavior: "smooth" });
            });

            $("#mapAddBtn").on("click", function () {
                addCourse(1);
            });

            $("#modalCloseBtn, #detailModal").on("click", function (event) {
                if (event.target.id === "detailModal" || event.target.id === "modalCloseBtn") {
                    $("#detailModal").fadeOut(160);
                }
            });

            $("#modalAddBtn").on("click", function () {
                addCourse(selectedId);
                $("#detailModal").fadeOut(160);
            });
        });
    </script>
</body>
</html>
